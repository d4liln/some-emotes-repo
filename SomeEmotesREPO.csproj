<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Authors>ImGogole</Authors>
    <Version>2.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <PluginOutputDir>$(BepInExDirectory)\plugins</PluginOutputDir>
  </PropertyGroup>
  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
    <EnableGameReferences>true</EnableGameReferences>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="Linkoid.Repo.Plugin.Build" Version="*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Directory.Repo.props" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rig probe is a development tool: it binds the avatar bones and forces a pose
         onto them, which is how the clone-free emote system was worked out. It has no use
         to a player, so it is kept in the repository but left out of the shipped assembly.
         Delete the two lines below to build with it again; it binds its own settings and
         needs nothing else, beyond an AddComponent<Rig.RepoRigProbe>() in the plugin. -->
    <Compile Remove="Rig/RepoRigProbe.cs" />
    <Compile Remove="Rig/RigPoseFile.cs" />

    <Compile Remove="Untrack/**" />
    <None Remove="Untrack/**" />
    <Compile Remove="Codebase/**" />
    <None Remove="Codebase/**" />
    <Compile Remove="plugins/**" />
    <None Remove="plugins/**" />
  </ItemGroup>
  <ItemGroup>
</ItemGroup>
</Project>
